---
// alisokni.com landing page
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/images/prototype.PNG" />
    <link rel="apple-touch-icon" href="/images/prototype.PNG" />
    <link rel="preload" href="/fonts/NHaasGroteskDSPro-65Md.otf" as="font" type="font/otf" crossorigin />
    <title>ali</title>
  </head>
  <body>
    <video class="bg" autoplay muted loop playsinline preload="auto">
      <source src="/videos/background.mp4" type="video/mp4" />
    </video>

    <img class="center" src="/references/alisokni27/18183270571393790.jpg" alt="" draggable="false" />

    <div class="corner">
      <span class="label">artist</span>
      <h1 class="name">ali</h1>
    </div>

    <div class="corner-left">
      <a class="name link" href="https://paradisiacal.space">paradisiacal</a>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Haas Grotesk Display";
    src: url("/fonts/NHaasGroteskDSPro-65Md.otf") format("opentype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  .bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .center {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    display: block;
    width: auto;
    height: auto;
    max-width: min(80vw, 520px);
    max-height: 60vh;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .corner {
    position: fixed;
    right: calc(24px + env(safe-area-inset-right));
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    color: #fff;
    text-transform: lowercase;
  }

  .corner-left {
    position: fixed;
    left: calc(24px + env(safe-area-inset-left));
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 2;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    color: #fff;
    text-transform: lowercase;
    transform: translateZ(0);
    will-change: transform;
  }

  .link,
  .link:link,
  .link:visited,
  .link:hover,
  .link:focus,
  .link:active {
    display: block;
    color: #fff;
    text-decoration: none !important;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .label {
    color: #fff;
    text-transform: none;
    font-size: clamp(14px, 1.4vw, 18px);
    letter-spacing: 0.01em;
    opacity: 0.75;
    cursor: default;
  }

  .name {
    margin: 0;
    font-size: clamp(28px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
</style>