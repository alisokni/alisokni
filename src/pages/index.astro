---
// alisokni.com landing page
const site = "https://alisokni.com";
const title = "Ali Sokni";
const description =
  "Ali Sokni — artist and researcher. MA candidate at The New School for Social Research, BA from Boston University, and creator of paradisiacal.";
const shareImage = site + "/references/alisokni27/18183270571393790.jpg";

// add your profile links here (instagram, linkedin, etc.) — this is how google connects them to you
const profiles = [
  "https://paradisiacal.space",
  // "https://www.instagram.com/alis0kni",
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ali Sokni",
  url: site,
  image: shareImage,
  jobTitle: "Artist and researcher",
  alumniOf: { "@type": "CollegeOrUniversity", name: "Boston University" },
  affiliation: { "@type": "CollegeOrUniversity", name: "The New School for Social Research" },
  sameAs: profiles,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Sokni" />
    <link rel="canonical" href={site + "/"} />

    <!-- link previews (imessage, instagram, twitter, etc.) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ali Sokni" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + "/"} />
    <meta property="og:image" content={shareImage} />
    <meta property="profile:first_name" content="Ali" />
    <meta property="profile:last_name" content="Sokni" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <!-- tells google this site is about a person named ali sokni -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="icon" type="image/png" href="/images/prototype.PNG" />
    <link rel="apple-touch-icon" href="/images/prototype.PNG" />
    <link rel="preload" href="/fonts/NHaasGroteskDSPro-65Md.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <video class="bg" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="/videos/background.mp4" type="video/mp4" />
    </video>

    <div class="grid">
      <img src="/references/alisokni27/18152430997489663.jpg" alt="Work by Ali Sokni" draggable="false" />
      <img src="/references/alisokni27/17942362896266370.jpg" alt="Work by Ali Sokni" draggable="false" />
      <img src="/references/alisokni27/17967882831094821.jpg" alt="Work by Ali Sokni" draggable="false" />
    </div>

    <div class="top">
      <div class="edu">
        <span>ma candidate, the new school for social research</span>
        <span>ba, boston university</span>
      </div>
      <img class="center" src="/references/alisokni27/18183270571393790.jpg" alt="Ali Sokni" draggable="false" />
    </div>

    <div class="corner">
      <h1 class="name">ali<span class="sr"> sokni</span></h1>
    </div>

    <div class="corner-left">
      <a class="name link" href="/story">drafts</a>
      <a class="name link" href="https://paradisiacal.space">paradisiacal</a>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Haas Grotesk Display";
    src: url("/fonts/NHaasGroteskDSPro-65Md.otf") format("opentype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    background: #000;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }

  /* readable by search engines and screen readers, not shown on screen */
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* top-left: three images, seamless, no gaps or borders */
  .grid {
    --tile: clamp(64px, 9vw, 130px);
    position: fixed;
    top: calc(20px + env(safe-area-inset-top));
    left: calc(24px + env(safe-area-inset-left));
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, var(--tile));
    gap: 0;
  }

  .grid img {
    display: block;
    width: var(--tile);
    height: var(--tile);
    object-fit: cover;
    border: 0;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* on phones: stack them vertically */
  @media (max-width: 640px) {
    .grid {
      --tile: 72px;
      grid-template-columns: var(--tile);
    }
  }

  /* top-right: blue text block + image */
  .top {
    position: fixed;
    top: calc(20px + env(safe-area-inset-top));
    right: calc(24px + env(safe-area-inset-right));
    z-index: 1;
    display: flex;
    align-items: stretch;
    gap: 14px;
  }

  /* royal blue block behind the text: as wide as the text, as tall as the image */
  .edu {
    background: #4169e1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    max-width: 40vw;
    text-align: right;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    font-size: clamp(12px, 1.1vw, 15px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #fff;
    text-transform: lowercase;
  }

  .edu span {
    opacity: 0.75;
  }

  .center {
    align-self: flex-start;
    display: block;
    width: auto;
    height: auto;
    max-width: min(30vw, 200px);
    max-height: 30vh;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .corner {
    position: fixed;
    right: calc(24px + env(safe-area-inset-right));
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    color: #fff;
    text-transform: lowercase;
  }

  .corner-left {
    position: fixed;
    left: calc(24px + env(safe-area-inset-left));
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    color: #fff;
    text-transform: lowercase;
    transform: translateZ(0);
    will-change: transform;
  }

  /* links: plain white text, no underline, box, highlight or visited color */
  .link,
  .link:link,
  .link:visited,
  .link:hover,
  .link:focus,
  .link:focus-visible,
  .link:active {
    display: block;
    color: #fff;
    background: none;
    text-decoration: none !important;
    outline: none;
    box-shadow: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .name {
    margin: 0;
    font-size: clamp(28px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* bigger "ali" and "paradisiacal" on phones */
  @media (max-width: 640px) {
    .name {
      font-size: clamp(34px, 10vw, 46px);
    }

    /* top right on phones: image on top, blue block below it at the same width */
    .top {
      --col: 150px;
      --blue-h: 180px;
      flex-direction: column;
      align-items: flex-end;
      gap: 14px;
    }
    .center {
      order: -1;
      align-self: auto;
      width: var(--col);
      max-width: none;
      max-height: none;
    }
    .edu {
      width: var(--col);
      max-width: none;
      min-height: var(--blue-h);
    }
  }
</style>