---
// alisokni.com/index1 — white-background version of the landing page
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/images/prototype.PNG" />
    <link rel="apple-touch-icon" href="/images/prototype.PNG" />
    <link rel="preload" href="/fonts/NHaasGroteskDSPro-65Md.otf" as="font" type="font/otf" crossorigin />
    <title>ali</title>
  </head>
  <body>
    <header class="header">
      <div class="grid">
        <img src="/references/alisokni27/18152430997489663.jpg" alt="" draggable="false" />
        <img src="/references/alisokni27/17942362896266370.jpg" alt="" draggable="false" />
        <img src="/references/alisokni27/17967882831094821.jpg" alt="" draggable="false" />
      </div>

      <div class="top">
        <div class="edu">
          <span>ma candidate, the new school for social research</span>
          <span>ba, boston university</span>
        </div>
        <img class="center" src="/references/alisokni27/18183270571393790.jpg" alt="" draggable="false" />
      </div>
    </header>

    <footer class="footer">
      <video class="footer-video" autoplay muted loop playsinline preload="auto">
        <source src="/videos/background.mp4" type="video/mp4" />
      </video>

      <div class="corner-left">
        <a class="name link" href="/story">drafts</a>
        <a class="name link" href="https://paradisiacal.space">paradisiacal</a>
      </div>

      <div class="corner">
        <h1 class="name">ali</h1>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Haas Grotesk Display";
    src: url("/fonts/NHaasGroteskDSPro-65Md.otf") format("opentype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    background: #fff;
    color: #000;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }

  /* top row: left images | blue block + image on the right */
  .header {
    position: fixed;
    top: calc(20px + env(safe-area-inset-top));
    left: calc(24px + env(safe-area-inset-left));
    right: calc(24px + env(safe-area-inset-right));
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* top-left: three images, seamless, no gaps or borders */
  .grid {
    --tile: clamp(64px, 9vw, 130px);
    flex: none;
    display: grid;
    grid-template-columns: repeat(3, var(--tile));
    gap: 0;
  }

  .grid img {
    display: block;
    width: var(--tile);
    height: var(--tile);
    object-fit: cover;
    border: 0;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* top-right: blue text block + image */
  .top {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: stretch;
    gap: 14px;
  }

  /* royal blue block behind the text: as wide as the text, as tall as the image */
  .edu {
    background: #4169e1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    max-width: 40vw;
    text-align: right;
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    font-size: clamp(12px, 1.1vw, 15px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #fff;
    text-transform: lowercase;
  }

  .edu span {
    opacity: 0.75;
  }

  .center {
    align-self: flex-start;
    display: block;
    width: auto;
    height: auto;
    max-width: min(30vw, 200px);
    max-height: 30vh;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* footer: video band exactly as tall as the bottom text, white text on top */
  .footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding:
      20px
      calc(24px + env(safe-area-inset-right))
      calc(20px + env(safe-area-inset-bottom))
      calc(24px + env(safe-area-inset-left));
    font-family: "Haas Grotesk Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 500;
    color: #fff;
    text-transform: lowercase;
  }

  .footer-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .corner,
  .corner-left {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .corner {
    align-items: flex-end;
  }

  .corner-left {
    align-items: flex-start;
  }

  /* links: plain white text, no underline, box, highlight or visited color */
  .link,
  .link:link,
  .link:visited,
  .link:hover,
  .link:focus,
  .link:focus-visible,
  .link:active {
    display: block;
    color: #fff;
    background: none;
    text-decoration: none !important;
    outline: none;
    box-shadow: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .name {
    margin: 0;
    font-size: clamp(28px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* phones */
  @media (max-width: 640px) {
    .grid {
      --tile: 72px;
      grid-template-columns: var(--tile);
    }

    .name {
      font-size: clamp(34px, 10vw, 46px);
    }

    /* image on top, blue block below it at the same width */
    .top {
      --col: 150px;
      --blue-h: 180px;
      flex-direction: column;
      align-items: flex-end;
      gap: 14px;
    }
    .center {
      order: -1;
      align-self: auto;
      width: var(--col);
      max-width: none;
      max-height: none;
    }
    .edu {
      width: var(--col);
      max-width: none;
      min-height: var(--blue-h);
    }
  }
</style>